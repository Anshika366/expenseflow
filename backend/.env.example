# ExpenseFlow Backend Environment Configuration Example
# Copy this file to .env and configure your values.

# MongoDB Connection String (e.g. mongodb://localhost:27017 or MongoDB Atlas URI)
MONGO_DETAILS=mongodb://127.0.0.1:27017

# JWT Secret Key (required in production; minimum 32 random characters)
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-characters-long

# JWT Token Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Environment (development | production)
ENV=development

# Allowed CORS Origins (comma-separated URLs without trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://expenseflow-flax.vercel.app
